# ─── Database Configuration ──────────────────────────────────────────────────
# PostgreSQL connection string (Supabase Postgres with pgvector).
# In production, use transaction pooler port 6543; in development, session port 5432 is fine.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?sslmode=require

# Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ─── FastAPI Server Configuration ──────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
APP_NAME="Lumina API"
APP_ENV=development # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated list of allowed CORS origins (* allows all, but avoid in production if strict cookie-sharing is needed)
CORS_ORIGINS="*"

# ─── Supabase Integration ─────────────────────────────────────────────────────
# URL of your Supabase project (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# ANON key (public client key) for token verification fallbacks
SUPABASE_ANON_KEY=your-supabase-anon-key
# service_role key (server secret) for storage operations bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Legacy HS256 JWT secret for fast local token verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUD=authenticated
SUPABASE_STORAGE_BUCKET=lumina-documents

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
# Cloudinary credentials for generated visuals and raw document files
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=lumina

# ─── Gemini AI Provider ───────────────────────────────────────────────────────
# API key for structured text generation, embeddings (RAG), and Socratic evaluations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
EMBEDDING_DIM=1536

# ─── VEO Video Generation ────────────────────────────────────────────────────
VEO_ENABLED=false
VEO_API_KEY=your_veo_api_key_here
VEO_MODEL=veo-3.1-generate-preview

# ─── RAG Pipeline Options ────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.0
RAG_MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=50

# ─── Crucible Assessment Options ─────────────────────────────────────────────
CHAT_HISTORY_WINDOW=8
CRUCIBLE_MAX_TURNS=5
RATE_LIMIT_ENABLED=true
JOBS_MAX_WORKERS=4
