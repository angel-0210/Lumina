# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase with pgvector).
# Hint: Use port 6543 (transaction pooling) in production.
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?sslmode=require

# ─── FastAPI Server ──────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
APP_ENV=development # development | test | production
LOG_LEVEL=INFO

# ─── Supabase Integration ─────────────────────────────────────────────────────
# URL of your Supabase project (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# ANON key (public client key) for token verification fallbacks
SUPABASE_ANON_KEY=your-supabase-anon-key
# Legacy HS256 JWT secret for fast local token verification (found in Supabase Settings -> API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Cloudinary Media Storage ─────────────────────────────────────────────────
# Cloudinary credentials for generated visuals and raw document files
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Gemini AI Provider ───────────────────────────────────────────────────────
# API key for structured text generation, embeddings (RAG), and Socratic evaluations
GEMINI_API_KEY=your_gemini_api_key_here
