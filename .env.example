# ─── Lumina Client Environment Variables ─────────────────────────────────────
#
# This file documents the environment variables needed for the Expo (mobile + web)
# client build. Copy to `.env` for local development.
#
# DEPLOYMENT TARGETS
# ──────────────────
# • Mobile (EAS build): set EXPO_PUBLIC_API_URL in eas.json or Expo dashboard
# • Web (Vercel): set EXPO_PUBLIC_API_URL in the Vercel project Environment Variables
# • Local dev: copy this file to .env and set the value below
#
# ─── Required ────────────────────────────────────────────────────────────────

# Production Render backend URL (used by Vercel web build and EAS mobile build)
EXPO_PUBLIC_API_URL=https://lumina-backend-psdz.onrender.com

# For local development — uncomment and replace localhost with your running FastAPI server
# For physical Android/iOS device testing, replace localhost with your machine's LAN IP
# e.g. http://192.168.1.50:8000
# EXPO_PUBLIC_API_URL=http://localhost:8000

