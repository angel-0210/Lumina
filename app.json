{
  "expo": {
    "name": "Lumina",
    "slug": "lumina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./client/assets/images/icon.png",
    "scheme": "lumina",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./client/assets/images/android-icon-foreground.png",
        "backgroundImage": "./client/assets/images/android-icon-background.png",
        "monochromeImage": "./client/assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./client/assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./client/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./client/assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
